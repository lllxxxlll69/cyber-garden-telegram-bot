HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# Obtain from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=
SESSION_HOURS=168
# Set true when deployed behind HTTPS; configure trusted proxy/network separately.
COOKIE_SECURE=false
# Android on the same Wi-Fi: HOST=0.0.0.0 and ALLOWED_HOSTS=192.168.1.10
ALLOWED_HOSTS=
SCHEDULE_TIMEZONE=Europe/Moscow
LLM_ENDPOINT=http://127.0.0.1:11434/api/chat
LLM_MODEL=
LLM_KEY=
